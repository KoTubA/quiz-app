---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Sans:wght@400;500;700&display=swap" rel="stylesheet" />

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	@tailwind base;

	@layer base {
	:root {
		--font-sans: 'Manrope', 'Noto Sans', system-ui, sans-serif;
		--foreground-brand-color: 0deg 0% 100%;
		--foreground-accent-color: 217deg 91% 60%;

		--surface-brand-1-color: 222deg 47% 11%;
		--surface-brand-2-color: 215deg 25% 27%;
		--surface-accent-1-color: 217deg 91% 60%;

		--success-color: 158deg 64% 52%;
		--error-color: 0deg 72% 51%;
		--current-color: 258deg 90% 66%;
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100dvh;
		width: 100%;
		background-color: hsl(var(--surface-brand-1-color) / 1);
		overflow: hidden;
	}

	input,
	button,
	textarea,
	select {
		font: inherit;
	}
	p,
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		overflow-wrap: break-word;
	}

	.scrollbar-hide::-webkit-scrollbar {
		display: none;
	}

	.scrollbar-hide {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	.section-scroll::-webkit-scrollbar {
		width: 10px;
	}

	.section-scroll::-webkit-scrollbar-track {
		background-color: #e4e4e4;
		border-radius: 12px;
	}

	.section-scroll::-webkit-scrollbar-thumb {
		border-radius: 12px;
		border: 2px solid transparent;
		background-clip: content-box;
		background-color: hsl(var(--surface-accent-1-color));
	}


	}

	@tailwind components;
	@tailwind utilities;
</style>
